rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Space code lookup index (e.g. SUPER-4892)
    match /space_codes/{code} {
      allow read, write: if isAuthenticated();
    }

    // Shared calendar spaces
    match /spaces/{spaceId} {
      // Any authenticated user can read or create a space, and members can update
      allow read, write: if isAuthenticated();

      // Collaborative activities, proposals & checklists inside space
      match /activities/{activityId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
