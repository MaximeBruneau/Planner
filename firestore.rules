rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSpaceMember(spaceId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds
      );
    }

    // 1. User profile documents: Only the user themselves can read or write their profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Space code lookup index (e.g. SUPER-4892)
    match /space_codes/{code} {
      // Any authenticated user can look up a specific code to join
      allow get: if isAuthenticated();
      // Block listing all codes to prevent scraping all spaces
      allow list: if false;
      // Creation allowed if authenticated and setting self as creator
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      // Update/delete only by the creator
      allow update, delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 3. Shared calendar spaces
    match /spaces/{spaceId} {
      // Read specific space: authenticated users can get (needed for code invite verification)
      allow get: if isAuthenticated();
      // List spaces: only if the user is a member
      allow list: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.memberIds);

      // Create space: creator must match authenticated user and be in memberIds
      allow create: if isAuthenticated() 
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Update space:
      // - Allowed if the user is already a member
      // - OR if the user is joining the space (adding their own uid to memberIds)
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.memberIds) ||
        (request.auth.uid in request.resource.data.memberIds)
      );

      // Delete space: only the space creator/owner
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;

      // Collaborative activities / plans inside space
      match /activities/{activityId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      // Idea bank inside space
      match /ideas/{ideaId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      // Notifications inside space
      match /notifications/{notificationId} {
        allow read, write: if isSpaceMember(spaceId);
      }
    }
  }
}
